# Environment terpisah untuk integration test (bun test) — DB & port beda dari dev
# supaya tidak bentrok dengan server dev yang mungkin sedang jalan, dan supaya data
# test tidak mengotori data dev.
#
# Copy ke .env.test lalu buat databasenya:
#   createdb kainova_erp_test   (atau psql -c "CREATE DATABASE kainova_erp_test;")
#   DATABASE_URL=postgres://kainova:kainova@localhost:5432/kainova_erp_test bun run db:migrate
#
# Lihat backend/tests/README.md untuk detail.
PORT=3099
NODE_ENV=test
DATABASE_URL=postgres://kainova:kainova@localhost:5432/kainova_erp_test
JWT_SECRET=test-secret-key-not-for-production
JWT_EXPIRES_IN=7d
